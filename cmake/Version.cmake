# Shared by configure, the build-time refresh, and isolated metadata tests.
function(insidious_read_version source output)
    file(READ "${source}/version.txt" value)
    if(NOT value MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\n$")
        message(FATAL_ERROR "version.txt must contain MAJOR.MINOR.PATCH and one trailing newline")
    endif()
    string(STRIP "${value}" value)
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(insidious_build_identity source output commit_output)
    insidious_read_version("${source}" version)
    set(identity "${version}-dev+unknown")
    set(commit "")
    # Require this directory's own Git marker; never inherit a parent checkout.
    if(EXISTS "${source}/.git")
        find_package(Git QUIET)
        if(GIT_FOUND)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse --verify HEAD
                RESULT_VARIABLE status OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(status EQUAL 0)
                execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" status --porcelain --untracked-files=normal
                    RESULT_VARIABLE status OUTPUT_VARIABLE changes ERROR_QUIET)
                if(NOT status EQUAL 0)
                    message(FATAL_ERROR "Cannot determine Git worktree state")
                endif()
                execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse --verify "refs/tags/v${version}^{commit}"
                    RESULT_VARIABLE tag_status OUTPUT_VARIABLE tag_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
                string(SUBSTRING "${commit}" 0 12 short)
                set(identity "${version}-dev+g${short}")
                if(changes STREQUAL "" AND tag_status EQUAL 0 AND tag_commit STREQUAL commit)
                    set(identity "${version}")
                elseif(NOT changes STREQUAL "")
                    string(APPEND identity ".dirty")
                endif()
            endif()
        endif()
    elseif(EXISTS "${source}/source-metadata.json")
        file(READ "${source}/source-metadata.json" metadata)
        string(JSON archive_version ERROR_VARIABLE error GET "${metadata}" version)
        if(error OR NOT archive_version STREQUAL version)
            message(FATAL_ERROR "Source metadata version does not match version.txt")
        endif()
        string(JSON commit ERROR_VARIABLE error GET "${metadata}" commit)
        string(LENGTH "${commit}" length)
        if(error OR NOT length EQUAL 40 OR NOT commit MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Source metadata requires a full lowercase SHA-1 commit")
        endif()
        set(identity "${version}")
    endif()
    set(${output} "${identity}" PARENT_SCOPE)
    set(${commit_output} "${commit}" PARENT_SCOPE)
endfunction()
