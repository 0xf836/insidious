# Future source packaging invokes this against a verified clean release checkout.
include("${CMAKE_CURRENT_LIST_DIR}/Version.cmake")
if(NOT DEFINED OUTPUT_FILE OR NOT EXISTS "${SOURCE_DIR}/.git")
    message(FATAL_ERROR "SOURCE_DIR must be a Git checkout and OUTPUT_FILE must be specified")
endif()
insidious_read_version("${SOURCE_DIR}" version)
insidious_build_identity("${SOURCE_DIR}" identity commit)
if(NOT identity STREQUAL version OR commit STREQUAL "")
    message(FATAL_ERROR "Source metadata requires the matching release tag and clean sources")
endif()
if(EXISTS "${OUTPUT_FILE}")
    message(FATAL_ERROR "Refusing to overwrite source metadata")
endif()
file(WRITE "${OUTPUT_FILE}" "{\n  \"version\": \"${version}\",\n  \"commit\": \"${commit}\"\n}\n")
