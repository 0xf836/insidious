cmake_minimum_required(VERSION 3.24)
include("${PROJECT_ROOT}/cmake/Version.cmake")
find_package(Git REQUIRED)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/repo")
set(repo "${TEST_ROOT}/repo")
find_program(BASH_EXECUTABLE bash REQUIRED)
function(git)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.hooksPath=/dev/null -c tag.gpgSign=false -C "${repo}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Git fixture command failed: ${ARGN}: ${error}")
    endif()
endfunction()
function(expect expected)
    insidious_build_identity("${repo}" actual commit)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected ${expected}, got ${actual}")
    endif()
endfunction()
function(generate source succeeds)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}"
        "-DOUTPUT_DIR=${TEST_ROOT}/output" -P "${PROJECT_ROOT}/cmake/GenerateVersion.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(succeeds AND NOT result EQUAL 0)
        message(FATAL_ERROR "Metadata generation failed: ${error}")
    elseif(NOT succeeds AND result EQUAL 0)
        message(FATAL_ERROR "Invalid metadata accepted")
    endif()
endfunction()
function(build_probe expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}/probe-build"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Probe build failed: ${output} ${error}")
    endif()
    execute_process(COMMAND "${TEST_ROOT}/probe-build/probe" OUTPUT_VARIABLE actual RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Incremental probe expected ${expected}, got ${actual}")
    endif()
endfunction()
file(WRITE "${repo}/version.txt" "0.1.0\n")
file(WRITE "${repo}/.gitignore" "ignored/\n")
# Exercise the actual production refresh/include wiring with a tiny executable.
file(WRITE "${repo}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(probe LANGUAGES CXX)\ninclude(\"${PROJECT_ROOT}/cmake/BuildMetadata.cmake\")\nadd_executable(probe main.cpp)\ntarget_link_libraries(probe PRIVATE insidious_version)\n")
file(WRITE "${repo}/main.cpp" "#include \"build_version.h\"\n#include <iostream>\nint main() { std::cout << insidious::build::Version; }\n")
git(init --quiet)
git(config user.name "Version test")
git(config user.email "version-test@example.invalid")
git(config commit.gpgsign false)
git(add .)
git(commit --quiet -m initial)
insidious_build_identity("${repo}" development commit)
string(SUBSTRING "${commit}" 0 12 short)
expect("0.1.0-dev+g${short}")
git(tag v9.9.9)
expect("0.1.0-dev+g${short}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${repo}"
    "-DOUTPUT_FILE=${TEST_ROOT}/untagged.json" -P "${PROJECT_ROOT}/cmake/WriteSourceMetadata.cmake"
    RESULT_VARIABLE untagged_written OUTPUT_QUIET ERROR_QUIET)
if(untagged_written EQUAL 0)
    message(FATAL_ERROR "Untagged source metadata accepted")
endif()
git(-c tag.gpgSign=false tag -a v0.1.0 -m release)
expect("0.1.0")
file(MAKE_DIRECTORY "${repo}/ignored")
file(WRITE "${repo}/ignored/generated" "ignored output")
expect("0.1.0")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${repo}" -B "${TEST_ROOT}/probe-build" -G Ninja
    RESULT_VARIABLE configured OUTPUT_QUIET)
if(NOT configured EQUAL 0)
    message(FATAL_ERROR "Probe configuration failed")
endif()
build_probe("0.1.0")
file(APPEND "${repo}/main.cpp" "\n// dirty fixture\n")
expect("0.1.0-dev+g${short}.dirty")
build_probe("0.1.0-dev+g${short}.dirty")
git(add main.cpp)
# Staged changes must also count as dirty.
expect("0.1.0-dev+g${short}.dirty")
git(commit --quiet -m next)
insidious_build_identity("${repo}" next commit)
build_probe("${next}")
file(WRITE "${repo}/untracked" "untracked fixture\n")
expect("${next}.dirty")
file(REMOVE "${repo}/untracked")
# A version-only update is noticed by the build-time refresh too.
file(CREATE_LINK "${repo}" "${TEST_ROOT}/insidious" SYMBOLIC)
execute_process(COMMAND "${BASH_EXECUTABLE}" -c "source \"$1\"; srcdir=\"$2\"; pkgver" -- "${PROJECT_ROOT}/PKGBUILD" "${TEST_ROOT}"
    RESULT_VARIABLE pkg_status OUTPUT_VARIABLE pkg_version ERROR_VARIABLE pkg_error)
string(SUBSTRING "${commit}" 0 7 pkg_short)
if(NOT pkg_status EQUAL 0 OR NOT pkg_version STREQUAL "0.1.0.r2.g${pkg_short}")
    message(FATAL_ERROR "PKGBUILD version mismatch: ${pkg_version}: ${pkg_error}")
endif()
file(WRITE "${repo}/version.txt" "0.2.0\n")
string(SUBSTRING "${commit}" 0 12 short)
build_probe("0.2.0-dev+g${short}.dirty")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${repo}"
    "-DOUTPUT_FILE=${TEST_ROOT}/invalid-source-metadata.json" -P "${PROJECT_ROOT}/cmake/WriteSourceMetadata.cmake"
    RESULT_VARIABLE dirty_written OUTPUT_QUIET ERROR_QUIET)
if(dirty_written EQUAL 0)
    message(FATAL_ERROR "Dirty source metadata writer accepted sources")
endif()
# Numeric source version should also drive pkgver after a version-only update.
execute_process(COMMAND "${BASH_EXECUTABLE}" -c "source \"$1\"; srcdir=\"$2\"; pkgver" -- "${PROJECT_ROOT}/PKGBUILD" "${TEST_ROOT}"
    RESULT_VARIABLE pkg_status OUTPUT_VARIABLE pkg_version)
if(NOT pkg_status EQUAL 0 OR NOT pkg_version STREQUAL "0.2.0.r2.g${pkg_short}")
    message(FATAL_ERROR "PKGBUILD did not follow version.txt")
endif()
file(WRITE "${repo}/version.txt" "0.1.0\n")
git(tag -d v0.1.0)
git(-c tag.gpgSign=false tag -a v0.1.0 -m release)
set(archive "${TEST_ROOT}/export")
file(MAKE_DIRECTORY "${archive}")
file(WRITE "${archive}/version.txt" "0.1.0\n")
# A Git-less subdirectory of a checkout must not inherit the parent's identity.
file(MAKE_DIRECTORY "${repo}/nested-export")
file(WRITE "${repo}/nested-export/version.txt" "0.1.0\n")
insidious_build_identity("${repo}/nested-export" unknown ignored)
if(NOT unknown STREQUAL "0.1.0-dev+unknown")
    message(FATAL_ERROR "Parent Git metadata leaked into export")
endif()
file(REMOVE_RECURSE "${repo}/nested-export")
insidious_build_identity("${archive}" unknown ignored)
if(NOT unknown STREQUAL "0.1.0-dev+unknown")
    message(FATAL_ERROR "Git-less export misidentified")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${repo}"
    "-DOUTPUT_FILE=${archive}/source-metadata.json" -P "${PROJECT_ROOT}/cmake/WriteSourceMetadata.cmake"
    RESULT_VARIABLE written)
if(NOT written EQUAL 0)
    message(FATAL_ERROR "Clean tagged source metadata write failed")
endif()
insidious_build_identity("${archive}" release archive_commit)
if(NOT release STREQUAL "0.1.0" OR NOT archive_commit STREQUAL commit)
    message(FATAL_ERROR "Archive identity mismatch")
endif()
file(WRITE "${archive}/source-metadata.json" "{\"version\":\"9.9.9\",\"commit\":\"${commit}\"}")
generate("${archive}" FALSE)
file(WRITE "${archive}/source-metadata.json" "{\"version\":\"0.1.0\",\"commit\":\"bad\"}")
generate("${archive}" FALSE)
file(WRITE "${archive}/source-metadata.json" "not json")
generate("${archive}" FALSE)
file(REMOVE "${archive}/source-metadata.json")
foreach(invalid "0.1" "01.2.3\n" "0.1.0" "0.1.0\n\n" "0.1.0-extra\n")
    file(WRITE "${archive}/version.txt" "${invalid}")
    generate("${archive}" FALSE)
endforeach()
message(STATUS "Version identity, archive validation and incremental refresh passed")
